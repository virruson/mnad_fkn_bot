# dockerfile.migrations
FROM python:3.11-slim

WORKDIR /app

# Копируем зависимости
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем весь пакет bot/ — env.py импортирует из bot.utils.database и bot.models
COPY bot/ ./bot/

# alembic.ini — в корень /app (alembic ищет его здесь при запуске)
COPY bot/utils/alembic.ini ./alembic.ini

# Папка migrations в корне /app — именно там alembic ищет env.py и versions/
# (script_location = migrations в alembic.ini)
COPY bot/migrations ./migrations

# Ждём БД и применяем миграции
CMD ["sh", "-c", "sleep 5 && alembic upgrade head"]